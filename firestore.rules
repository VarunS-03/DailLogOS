rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL DENY-BY-DEFAULT
    // =========================================================================
    // Explicitly reject any access to unknown collections or unspecified paths.
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // AUTHENTICATION & AUTHORIZATION HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function accountWritesAllowed(uid) {
      let accountPath = /databases/$(database)/documents/users/$(uid);
      let tombstonePath = /databases/$(database)/documents/accountDeletionTombstones/$(uid);
      return !exists(tombstonePath) &&
             (!exists(accountPath) || get(accountPath).data.get('deletionInProgress', false) != true);
    }

    function hasCurrentDaySyncState(uid, dateId, revision) {
      let statePath = /databases/$(database)/documents/users/$(uid)/daySyncState/$(dateId);
      return existsAfter(statePath) &&
             getAfter(statePath).data.revision == revision &&
             getAfter(statePath).data.committedAt == request.time;
    }

    // Validates strict ISO 8601 calendar date format (YYYY-MM-DD)
    function isValidDateId(dateId) {
      return dateId is string &&
             dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // =========================================================================
    // SCHEMA & INVARIANT VALIDATORS
    // =========================================================================

    // User Profile Validator (/users/{uid})
    function isValidUserProfile(data, uid) {
      return data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
             (!('uid' in data) || data.uid == uid) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User Settings Validator (/users/{uid}/settings/{settingId})
    function isValidUserSettings(data) {
      return (!('defaultWorkoutMode' in data) || data.defaultWorkoutMode in ['gym', 'home']) &&
             (!('theme' in data) || data.theme in ['dark', 'light']) &&
             (!('academicSchedule' in data) || data.academicSchedule is map) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             (!('systemConfiguration' in data) || isValidSystemConfiguration(data.systemConfiguration));
    }

    function isValidSystemModuleList(value) {
      return value is list && value.size() <= 5 &&
             (value.size() < 1 || value[0] in ['academics', 'dsa', 'workout', 'projects', 'insights']) &&
             (value.size() < 2 || value[1] in ['academics', 'dsa', 'workout', 'projects', 'insights']) &&
             (value.size() < 3 || value[2] in ['academics', 'dsa', 'workout', 'projects', 'insights']) &&
             (value.size() < 4 || value[3] in ['academics', 'dsa', 'workout', 'projects', 'insights']) &&
             (value.size() < 5 || value[4] in ['academics', 'dsa', 'workout', 'projects', 'insights']);
    }

    function isValidDashboardWidgetList(value) {
      return value is list && value.size() <= 6 &&
             (value.size() < 1 || value[0] in ['briefing', 'commitments', 'schedule', 'workspaces', 'goals', 'custom_trackers']) &&
             (value.size() < 2 || value[1] in ['briefing', 'commitments', 'schedule', 'workspaces', 'goals', 'custom_trackers']) &&
             (value.size() < 3 || value[2] in ['briefing', 'commitments', 'schedule', 'workspaces', 'goals', 'custom_trackers']) &&
             (value.size() < 4 || value[3] in ['briefing', 'commitments', 'schedule', 'workspaces', 'goals', 'custom_trackers']) &&
             (value.size() < 5 || value[4] in ['briefing', 'commitments', 'schedule', 'workspaces', 'goals', 'custom_trackers']) &&
             (value.size() < 6 || value[5] in ['briefing', 'commitments', 'schedule', 'workspaces', 'goals', 'custom_trackers']);
    }

    function isValidCustomTracker(value) {
      return value is map &&
             value.keys().hasOnly(['id', 'name', 'unit', 'dailyTarget']) &&
             value.keys().hasAll(['id', 'name', 'unit']) &&
             value.id is string && value.id.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$') &&
             value.name is string && value.name.size() > 0 && value.name.size() <= 50 &&
             value.unit is string && value.unit.size() <= 20 &&
             (!('dailyTarget' in value) || (value.dailyTarget is number && value.dailyTarget >= 0 && value.dailyTarget <= 100000));
    }

    function isValidCustomTrackerList(value) {
      return value is list && value.size() <= 10 &&
             (value.size() < 1 || isValidCustomTracker(value[0])) &&
             (value.size() < 2 || isValidCustomTracker(value[1])) &&
             (value.size() < 3 || isValidCustomTracker(value[2])) &&
             (value.size() < 4 || isValidCustomTracker(value[3])) &&
             (value.size() < 5 || isValidCustomTracker(value[4])) &&
             (value.size() < 6 || isValidCustomTracker(value[5])) &&
             (value.size() < 7 || isValidCustomTracker(value[6])) &&
             (value.size() < 8 || isValidCustomTracker(value[7])) &&
             (value.size() < 9 || isValidCustomTracker(value[8])) &&
             (value.size() < 10 || isValidCustomTracker(value[9]));
    }

    function isValidCustomTrackerValue(value) {
      return value is map &&
             value.keys().hasOnly(['trackerId', 'value']) &&
             value.keys().hasAll(['trackerId', 'value']) &&
             value.trackerId is string && value.trackerId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$') &&
             value.value is number && value.value >= 0 && value.value <= 100000;
    }

    function isValidCustomTrackerValues(value) {
      return value is list && value.size() <= 10 &&
             (value.size() < 1 || isValidCustomTrackerValue(value[0])) &&
             (value.size() < 2 || isValidCustomTrackerValue(value[1])) &&
             (value.size() < 3 || isValidCustomTrackerValue(value[2])) &&
             (value.size() < 4 || isValidCustomTrackerValue(value[3])) &&
             (value.size() < 5 || isValidCustomTrackerValue(value[4])) &&
             (value.size() < 6 || isValidCustomTrackerValue(value[5])) &&
             (value.size() < 7 || isValidCustomTrackerValue(value[6])) &&
             (value.size() < 8 || isValidCustomTrackerValue(value[7])) &&
             (value.size() < 9 || isValidCustomTrackerValue(value[8])) &&
             (value.size() < 10 || isValidCustomTrackerValue(value[9]));
    }

    function isValidSystemConfiguration(value) {
      return value is map &&
             value.keys().hasOnly(['schemaVersion', 'enabledModules', 'dashboardLayout', 'customTrackers', 'goals', 'aiBehavior']) &&
             value.keys().hasAll(['schemaVersion', 'enabledModules', 'dashboardLayout', 'customTrackers', 'goals', 'aiBehavior']) &&
             value.schemaVersion == 1 &&
             isValidSystemModuleList(value.enabledModules) &&
             isValidDashboardWidgetList(value.dashboardLayout) &&
             isValidCustomTrackerList(value.customTrackers) &&
             value.goals is map &&
             value.goals.keys().hasOnly(['primary', 'secondary']) &&
             value.goals.keys().hasAll(['primary', 'secondary']) &&
             value.goals.primary is string && value.goals.primary.size() <= 500 &&
             value.goals.secondary is list && value.goals.secondary.size() <= 5 &&
             (value.goals.secondary.size() < 1 || (value.goals.secondary[0] is string && value.goals.secondary[0].size() > 0 && value.goals.secondary[0].size() <= 200)) &&
             (value.goals.secondary.size() < 2 || (value.goals.secondary[1] is string && value.goals.secondary[1].size() > 0 && value.goals.secondary[1].size() <= 200)) &&
             (value.goals.secondary.size() < 3 || (value.goals.secondary[2] is string && value.goals.secondary[2].size() > 0 && value.goals.secondary[2].size() <= 200)) &&
             (value.goals.secondary.size() < 4 || (value.goals.secondary[3] is string && value.goals.secondary[3].size() > 0 && value.goals.secondary[3].size() <= 200)) &&
             (value.goals.secondary.size() < 5 || (value.goals.secondary[4] is string && value.goals.secondary[4].size() > 0 && value.goals.secondary[4].size() <= 200)) &&
             value.aiBehavior in ['enabled', 'disabled'];
    }

    function isValidBoundedStringList(value, minItems, maxItems, maxItemLength, allowedValues) {
      return value is list && value.size() >= minItems && value.size() <= maxItems &&
             (value.size() < 1 || (value[0] is string && value[0].size() <= maxItemLength && value[0] in allowedValues)) &&
             (value.size() < 2 || (value[1] is string && value[1].size() <= maxItemLength && value[1] in allowedValues)) &&
             (value.size() < 3 || (value[2] is string && value[2].size() <= maxItemLength && value[2] in allowedValues)) &&
             (value.size() < 4 || (value[3] is string && value[3].size() <= maxItemLength && value[3] in allowedValues)) &&
             (value.size() < 5 || (value[4] is string && value[4].size() <= maxItemLength && value[4] in allowedValues));
    }

    function isValidOnboardingAnswers(data) {
      return data is map &&
             data.keys().hasOnly([
               'schemaVersion', 'targetRole', 'customRoleTitle', 'chronotype', 'wakeTime', 'sleepTime',
               'deepWorkCapacity', 'availableHoursPerDay', 'workDaysPerWeek', 'fixedCommitments',
               'primaryGoal', 'secondaryGoals', 'trackingAreas', 'workoutMode', 'preferredSessionMinutes',
               'planningStyle', 'appPreferences', 'customInstructions'
             ]) &&
             data.keys().hasAll([
               'schemaVersion', 'targetRole', 'customRoleTitle', 'chronotype', 'wakeTime', 'sleepTime',
               'deepWorkCapacity', 'availableHoursPerDay', 'workDaysPerWeek', 'fixedCommitments',
               'primaryGoal', 'secondaryGoals', 'trackingAreas', 'workoutMode', 'preferredSessionMinutes',
               'planningStyle', 'appPreferences', 'customInstructions'
             ]) &&
             data.schemaVersion == 1 &&
             data.targetRole in ['student', 'engineer', 'founder', 'creator', 'fitness', 'custom'] &&
             data.customRoleTitle is string && data.customRoleTitle.size() <= 80 &&
             data.chronotype in ['early', 'standard', 'night'] &&
             data.wakeTime is string && data.wakeTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
             data.sleepTime is string && data.sleepTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
             data.deepWorkCapacity in ['minimum', 'moderate', 'high'] &&
             data.availableHoursPerDay is int && data.availableHoursPerDay >= 1 && data.availableHoursPerDay <= 16 &&
             data.workDaysPerWeek is int && data.workDaysPerWeek >= 1 && data.workDaysPerWeek <= 7 &&
             data.fixedCommitments is string && data.fixedCommitments.size() <= 1000 &&
             data.primaryGoal is string && data.primaryGoal.size() <= 500 &&
             data.secondaryGoals is string && data.secondaryGoals.size() <= 500 &&
             isValidBoundedStringList(data.trackingAreas, 1, 5, 32, ['dsa', 'academics', 'fitness', 'projects', 'reading']) &&
             data.workoutMode in ['gym', 'home'] &&
             data.preferredSessionMinutes in [25, 50, 90] &&
             data.planningStyle in ['minimal', 'balanced', 'structured'] &&
             isValidBoundedStringList(data.appPreferences, 0, 4, 32, ['daily_briefing', 'gentle_prompts', 'weekly_review', 'ai_suggestions']) &&
             data.customInstructions is string && data.customInstructions.size() <= 1000;
    }

    function isValidOnboardingRequirements(data) {
      return data is map &&
             data.keys().hasOnly(['schemaVersion', 'sourceAnswers', 'interpretation', 'source', 'userConfirmed', 'generatedAt']) &&
             data.keys().hasAll(['schemaVersion', 'sourceAnswers', 'interpretation', 'source', 'userConfirmed', 'generatedAt']) &&
             data.schemaVersion == 1 &&
             isValidOnboardingAnswers(data.sourceAnswers) &&
             data.interpretation is map &&
             data.interpretation.keys().hasOnly(['summary', 'priorityAreas', 'constraints']) &&
             data.interpretation.keys().hasAll(['summary', 'priorityAreas', 'constraints']) &&
             data.interpretation.summary is string &&
             data.interpretation.summary.size() > 0 &&
             data.interpretation.summary.size() <= 500 &&
             isValidBoundedStringList(data.interpretation.priorityAreas, 1, 5, 32, ['dsa', 'academics', 'fitness', 'projects', 'reading']) &&
             data.sourceAnswers.trackingAreas.hasAll(data.interpretation.priorityAreas) &&
             data.interpretation.constraints is string &&
             data.interpretation.constraints.size() <= 1000 &&
             data.source in ['gemini', 'offline'] &&
             data.userConfirmed is bool &&
             data.generatedAt is string && data.generatedAt.size() <= 64;
    }

    function isValidOnboardingProgress(data) {
      return data.keys().hasOnly(['status', 'version', 'currentStage', 'startedAt', 'completedAt', 'updatedAt', 'answers', 'requirements', 'systemConfiguration']) &&
             data.keys().hasAll(['status', 'version', 'currentStage', 'updatedAt']) &&
             data.status in ['not_started', 'in_progress', 'completed'] &&
             data.version is int && data.version >= 1 && data.version <= 100 &&
             data.currentStage is int && data.currentStage >= 1 && data.currentStage <= 6 &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             (!('startedAt' in data) || (data.startedAt is string && data.startedAt.size() <= 64)) &&
             (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64)) &&
             (!('answers' in data) || isValidOnboardingAnswers(data.answers)) &&
             (!('requirements' in data) ||
               (isValidOnboardingRequirements(data.requirements) &&
                'answers' in data &&
                data.requirements.sourceAnswers == data.answers)) &&
             (!('systemConfiguration' in data) ||
               (isValidSystemConfiguration(data.systemConfiguration) &&
                'requirements' in data &&
                data.requirements.userConfirmed == true));
    }

    // Behavioral Core fields remain embedded in the day document. Lists are
    // bounded here; detailed element validation is performed by the client
    // import validator because Firestore Rules cannot iterate arbitrary lists.
    function isValidDayStart(value) {
      return value is map &&
             value.date is string && value.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             value.startedAt is string && value.startedAt.size() <= 64 &&
             value.acceptedAt is string && value.acceptedAt.size() <= 64 &&
             value.capacityMode in ['normal', 'reduced', 'minimum'] &&
             value.firstAction is string && value.firstAction.size() > 0 && value.firstAction.size() <= 1000 &&
             (!('implementationIntention' in value) || (value.implementationIntention is string && value.implementationIntention.size() <= 1000));
    }

    function isValidBehavioralReview(value) {
      return value is map &&
             value.movedForward is string && value.movedForward.size() <= 2000 &&
             value.failureReasons is list && value.failureReasons.size() <= 10 &&
             value.adjustment is string && value.adjustment.size() <= 2000 &&
             value.reviewComplete is bool &&
             (!('completedAt' in value) || (value.completedAt is string && value.completedAt.size() <= 64));
    }

    function isValidTomorrowHandoff(value) {
      return value is map &&
             value.createdAt is string && value.createdAt.size() <= 64 &&
             value.firstAction is string && value.firstAction.size() > 0 && value.firstAction.size() <= 1000 &&
             (!('carryForwardOutcomeId' in value) || (value.carryForwardOutcomeId is string && value.carryForwardOutcomeId.size() <= 64)) &&
             (!('blockerAction' in value) || (value.blockerAction is string && value.blockerAction.size() <= 1000)) &&
             (!('dueReviewReference' in value) || (value.dueReviewReference is string && value.dueReviewReference.size() <= 500)) &&
             (!('adjustment' in value) || (value.adjustment is string && value.adjustment.size() <= 2000)) &&
             (!('note' in value) || (value.note is string && value.note.size() <= 2000));
    }

    // Daily Record Validator (/users/{uid}/days/{dateId})
    function isValidDayRecord(data, dateId) {
      return // Document Date must match the path ID to prevent ID spoofing / corruption
             data.date is string &&
             data.date == dateId &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&

             // Numeric bounds (1-5 for subjective scores, 0-100 for completion percentage)
             (!('mood' in data) || (data.mood is number && data.mood >= 1 && data.mood <= 5)) &&
             (!('energy' in data) || (data.energy is number && data.energy >= 1 && data.energy <= 5)) &&
             (!('sleep' in data) || (data.sleep is number && data.sleep >= 1 && data.sleep <= 5)) &&
             (!('completionPercentage' in data) || (data.completionPercentage is number && data.completionPercentage >= 0 && data.completionPercentage <= 100)) &&

             // Volumetric bounds on top-level strings to prevent document inflation
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             (!('tomorrowFirstAction' in data) || (data.tomorrowFirstAction is string && data.tomorrowFirstAction.size() <= 1000)) &&
             (!('dayOfWeek' in data) || (data.dayOfWeek is string && data.dayOfWeek.size() <= 20)) &&

             // Array collection bounds (capped to 50 entries each)
             (!('schedule' in data) || (data.schedule is list && data.schedule.size() <= 50)) &&
             (!('habits' in data) || (data.habits is list && data.habits.size() <= 50)) &&
             (!('dsa' in data) || (data.dsa is list && data.dsa.size() <= 50)) &&

             // Structural object blocks
             (!('academics' in data) || data.academics is map) &&
             (!('dailyReflection' in data) || data.dailyReflection is map) &&
             (!('workout' in data) || data.workout is map) &&
             (!('project' in data) || data.project is map) &&
             (!('skills' in data) || data.skills is map) &&
             // Versioned, bounded Behavioral Core contracts.
             (!('schemaVersion' in data) || (data.schemaVersion is int && data.schemaVersion >= 0 && data.schemaVersion <= 100)) &&
             (!('dayStart' in data) || isValidDayStart(data.dayStart)) &&
             (!('outcomes' in data) || (data.outcomes is list && data.outcomes.size() <= 10)) &&
             (!('focusSessions' in data) || (data.focusSessions is list && data.focusSessions.size() <= 20)) &&
             (!('recoveryDecisions' in data) || (data.recoveryDecisions is list && data.recoveryDecisions.size() <= 20)) &&
             (!('creditEvents' in data) || (data.creditEvents is list && data.creditEvents.size() <= 20)) &&
             (!('customTrackerValues' in data) || isValidCustomTrackerValues(data.customTrackerValues)) &&
             (!('behavioralReview' in data) || isValidBehavioralReview(data.behavioralReview)) &&
             (!('tomorrowHandoff' in data) || isValidTomorrowHandoff(data.tomorrowHandoff));

    }

    function isValidDayRecordUpdate(data, dateId, changed) {
      return data.date is string &&
             data.date == dateId &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             !changed.hasAny(['date', 'createdAt']) &&
             changed.hasOnly([
               'dayOfWeek', 'completionPercentage', 'notes', 'mood', 'energy', 'sleep',
               'dailyReflection', 'tomorrowFirstAction', 'schedule', 'habits', 'academics',
               'dsa', 'workout', 'project', 'skills', 'updatedAt', 'schemaVersion',
               'syncRevision', 'dayStart', 'outcomes', 'focusSessions', 'recoveryDecisions',
               'creditEvents', 'customTrackerValues', 'behavioralReview', 'tomorrowHandoff',
               'lastSyncedAt'
             ]) &&
             isValidDayRecord(data, dateId) &&
             (!changed.hasAny(['lastSyncedAt']) || data.lastSyncedAt is timestamp);
    }

    // =========================================================================
    // USER DATA SPACE: /users/{uid}
    // =========================================================================
    match /accountDeletionTombstones/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['status', 'startedAt']) &&
        request.resource.data.keys().hasAll(['status', 'startedAt']) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.startedAt == request.time;
      allow update, delete: if false;
    }

    match /users/{uid} {
      // User Profile root document
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && accountWritesAllowed(uid) &&
        isValidUserProfile(request.resource.data, uid) &&
        request.resource.data.uid == uid;
      allow update: if isOwner(uid) &&
        accountWritesAllowed(uid) &&
        isValidUserProfile(request.resource.data, uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      // Once the permanent tombstone exists, profile PII may be removed safely.
      allow delete: if isOwner(uid) &&
        exists(/databases/$(database)/documents/accountDeletionTombstones/$(uid));

      // User Settings Subcollection (/users/{uid}/settings/{settingId})
      match /settings/{settingId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && accountWritesAllowed(uid) && (settingId == 'main') && isValidUserSettings(request.resource.data);
        allow update: if isOwner(uid) && accountWritesAllowed(uid) && (settingId == 'main') && isValidUserSettings(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Account-level onboarding status is authoritative across devices.
      match /onboarding/{onboardingId} {
        allow read: if isOwner(uid) && onboardingId == 'main';
        allow create: if isOwner(uid) && accountWritesAllowed(uid) && onboardingId == 'main' && isValidOnboardingProgress(request.resource.data);
        allow update: if isOwner(uid) && accountWritesAllowed(uid) && onboardingId == 'main' && isValidOnboardingProgress(request.resource.data);
        allow delete: if isOwner(uid) && onboardingId == 'main';
      }

      // Private, bounded Coach Chat messages; each message is stored separately
      // so users can clear history and account deletion can remove it completely.
      match /coachChats/{chatId}/messages/{messageId} {
        allow read: if isOwner(uid) && chatId == 'main';
        allow create: if isOwner(uid) && accountWritesAllowed(uid) && chatId == 'main' &&
          request.resource.data.keys().hasOnly(['role', 'text', 'sequence', 'createdAt']) &&
          request.resource.data.keys().hasAll(['role', 'text', 'sequence', 'createdAt']) &&
          request.resource.data.role in ['user', 'assistant'] &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.sequence is int &&
          request.resource.data.sequence >= 0 &&
          request.resource.data.sequence <= 4102444800000 &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid) && chatId == 'main';
      }

      // User Daily Records Subcollection (/users/{uid}/days/{dateId})
      match /days/{dateId} {
        // Collection queries evaluate at the collection path, where dateId is
        // not bound to one document. Keep list access owner-scoped; validate
        // the date ID on direct document reads and every write.
        allow get: if isOwner(uid) && isValidDateId(dateId);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) &&
          accountWritesAllowed(uid) &&
          isValidDateId(dateId) &&
          request.resource.data.syncRevision == 1 &&
          hasCurrentDaySyncState(uid, dateId, request.resource.data.syncRevision) &&
          isValidDayRecord(request.resource.data, dateId);
        allow update: if isOwner(uid) &&
          accountWritesAllowed(uid) &&
          isValidDateId(dateId) &&
          request.resource.data.syncRevision is int &&
          request.resource.data.syncRevision >= 1 &&
          request.resource.data.syncRevision <= 2147483647 &&
          hasCurrentDaySyncState(uid, dateId, request.resource.data.syncRevision) &&
          isValidDayRecordUpdate(
            request.resource.data,
            dateId,
            request.resource.data.diff(resource.data).affectedKeys()
          );
        allow delete: if isOwner(uid) && isValidDateId(dateId);
      }

      // The per-day sync state is a small atomic commit marker that old
      // whole-document clients do not write.
      match /daySyncState/{dateId} {
        allow read: if isOwner(uid) && isValidDateId(dateId);
        allow create: if isOwner(uid) &&
          accountWritesAllowed(uid) &&
          isValidDateId(dateId) &&
          request.resource.data.keys().hasOnly(['revision', 'committedAt']) &&
          request.resource.data.keys().hasAll(['revision', 'committedAt']) &&
          request.resource.data.revision is int &&
          request.resource.data.revision >= 1 &&
          request.resource.data.committedAt == request.time;
        allow update: if isOwner(uid) &&
          accountWritesAllowed(uid) &&
          isValidDateId(dateId) &&
          request.resource.data.keys().hasOnly(['revision', 'committedAt']) &&
          request.resource.data.keys().hasAll(['revision', 'committedAt']) &&
          request.resource.data.revision is int &&
          request.resource.data.revision > resource.data.revision &&
          request.resource.data.committedAt == request.time;
        allow delete: if isOwner(uid) && isValidDateId(dateId);
      }
    }
  }
}
